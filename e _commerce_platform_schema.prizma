generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "core"]
}

model user {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  age               Int?
  gender            String?
  City              String?
  mobileNumber      String?
  customerSegment   String?
  role              String             @default("user")
  banned            Boolean            @default(false)
  banReason         String?
  banExpires        DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  sessions          session[]
  accounts          account[]
  agentChatSession  AgentChatSession?
  agentChatMessages AgentChatMessage[]
  transactions      Transaction[]

  @@schema("auth")
}

model session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?
  user           user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@schema("auth")
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@schema("auth")
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@schema("auth")
}

model Product {
  productId         String            @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  sku               String            @unique @db.VarChar(50)
  name              String            @db.VarChar(255)
  nameSi            String?           @map("name_si") @db.VarChar(255)
  description       String?
  descriptionSi     String?           @map("description_si")
  categoryId        String            @map("category_id") @db.Uuid
  price             Decimal           @db.Decimal(12, 2)
  stockQuantity     Int               @default(0) @map("stock_quantity")
  brand             String            @default("unbranded")
  purchaseFrequency PurchaseFrequency @default(medium) @map("purchase_frequency")
  imageUrl          String?           @map("image_url")
  isActive          Boolean           @default(true) @map("is_active")
  createdBy         String?           @map("created_by")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  category     Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  aliases      ProductAlias[]
  stockEntries StockEntry[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  promotions   Promotion[]
  transactions Transaction[]

  @@index([categoryId])
  @@index([isActive])
  @@index([sku])
  @@map("products")
  @@schema("core")
}

model Promotion {
  promotionId          String   @id @default(dbgenerated("gen_random_uuid()")) @map("promotion_id") @db.Uuid
  productId            String   @map("product_id") @db.Uuid
  discountPercentage   Decimal  @map("discount_percentage") @db.Decimal(5, 2)
  startDate            DateTime @map("start_date") @db.Timestamptz(6)
  endDate              DateTime @map("end_date") @db.Timestamptz(6)
  promotionType        String   @map("promotion_type") @db.VarChar(100)
  isTargettedPromotion Boolean  @default(false) @map("is_targetted_promotion")
  productScope         String?  @map("product_scope") @db.VarChar(100)
  status               String?   @default("active") @db.VarChar(50)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  transactions Transaction[]

  @@index([productId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("promotions")
  @@schema("core")
}

model ProductAlias {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  alias           String   @db.VarChar(255)
  aliasNormalized String   @map("alias_normalized") @db.VarChar(255)
  weight          Decimal  @default(1.0) @db.Decimal(6, 3)
  source          String   @default("generated") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([productId, aliasNormalized])
  @@index([aliasNormalized])
  @@index([productId])
  @@map("product_aliases")
  @@schema("core")
}

enum PurchaseFrequency {
  high
  medium
  low

  @@schema("core")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @unique @db.VarChar(100)
  nameSi    String?  @map("name_si") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("categories")
  @@schema("core")
}

enum StockEntryType {
  initial
  adjustment
  rebalance
  sale
  cancellation

  @@schema("core")
}

model StockEntry {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      String         @map("product_id") @db.Uuid
  quantityChange Int            @map("quantity_change")
  balanceAfter   Int            @map("balance_after")
  type           StockEntryType
  note           String?
  referenceId    String?        @map("reference_id")
  createdBy      String?        @map("created_by")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@index([productId, createdAt(sort: Desc)])
  @@index([type])
  @@map("stock_entries")
  @@schema("core")
}

enum CartStatus {
  active
  abandoned
  converted

  @@schema("core")
}

model Cart {
  id        String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String     @map("user_id")
  status    CartStatus @default(active)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  items CartItem[]

  @@index([userId])
  @@index([userId, status])
  @@map("carts")
  @@schema("core")
}

model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  quantity  Int      @default(1)
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
  @@schema("core")
}

enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled

  @@schema("core")
}

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String      @unique @map("order_number") @db.VarChar(30)
  userId          String      @map("user_id")
  status          OrderStatus @default(pending)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  tax             Decimal     @default(0) @db.Decimal(12, 2)
  total           Decimal     @default(0) @db.Decimal(12, 2)
  shippingAddress String?     @map("shipping_address")
  billingAddress  String?     @map("billing_address")
  notes           String?
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  items OrderItem[]
  transactions Transaction[]

  @@index([userId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
  @@schema("core")
}

model OrderItem {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId       String   @map("order_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  productName   String   @map("product_name") @db.VarChar(255)
  productNameSi String?  @map("product_name_si") @db.VarChar(255)
  productSku    String   @map("product_sku") @db.VarChar(50)
  quantity      Int
  unitPrice     Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
  @@schema("core")
}

model Transaction {
  transactionId   String   @id @default(dbgenerated("gen_random_uuid()")) @map("transaction_id") @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  invoiceNo       String   @unique @map("invoice_no") @db.VarChar(50)
  customerId      String   @map("customer_id")
  productId       String   @map("product_id") @db.Uuid
  quantity        Int
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
  transactionDate DateTime @map("transaction_date") @db.Timestamptz(6)
  discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
  promotionId     String?  @map("promotion_id") @db.Uuid

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer  user       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [productId], onDelete: Restrict)
  promotion Promotion? @relation(fields: [promotionId], references: [promotionId], onDelete: SetNull)

  @@index([orderId])
  @@index([customerId])
  @@index([productId])
  @@index([transactionDate])
  @@map("transactions")
  @@schema("core")
}

model AgentChatSession {
  id             String    @id
  userId         String    @unique(map: "agent_chat_session_user_id_key") @map("user_id")
  agentSessionId String    @map("agent_session_id")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  lastMessageAt  DateTime? @map("last_message_at") @db.Timestamptz(6)

  user     user               @relation(fields: [userId], references: [id], onDelete: Cascade, map: "agent_chat_session_user_id_fkey")
  messages AgentChatMessage[]

  @@map("agent_chat_session")
  @@schema("core")
}

model AgentChatMessage {
  id            String   @id
  chatSessionId String   @map("chat_session_id")
  userId        String   @map("user_id")
  role          String
  channel       String
  content       String
  transcription String?
  audioUrl      String?  @map("audio_url")
  language      String   @default("auto")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  chatSession AgentChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade, map: "agent_chat_message_chat_session_id_fkey")
  user        user             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "agent_chat_message_user_id_fkey")

  @@index([chatSessionId, createdAt], map: "idx_agent_chat_message_session_created")
  @@index([userId, createdAt], map: "idx_agent_chat_message_user_created")
  @@map("agent_chat_message")
  @@schema("core")
}
